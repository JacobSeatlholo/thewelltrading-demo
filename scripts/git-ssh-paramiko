#!/usr/bin/env python3
"""git-ssh-paramiko — a GIT_SSH replacement for environments without an ssh binary.

Git invokes $GIT_SSH exactly like the `ssh` command line:

    GIT_SSH=/path/to/this git push git@github.com:user/repo.git main

This wrapper parses a practical subset of ssh arguments, connects with
paramiko using ~/.ssh/id_ed25519, execs the remote command and pipes
stdin/stdout/stderr bidirectionally (git's pack protocol is full-duplex).

IMPORTANT: pumps use RAW reads (os.read / channel.recv) which return as soon
as *any* data is available. BufferedReader.read(n) / Channel.read(n) block
until the FULL n bytes arrive, which deadlocks git's small protocol requests.
"""

import os
import sys
import threading
import time
from pathlib import Path

import paramiko

# Max seconds to wait for the remote command to finish (big pushes allowed)
REMOTE_TIMEOUT = 900


def parse_args(argv):
    """Return (host, port, username, command) from ssh-style arguments."""
    host = port = None
    username = None
    command = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-p":
            i += 1
            port = int(argv[i])
        elif a == "-l":
            i += 1
            username = argv[i]
        elif a == "-i":
            i += 1  # identity file: ignore, we always use ~/.ssh/id_ed25519
        elif a == "-o":
            i += 1  # options: ignore (host keys auto-added below)
        elif a in ("-T", "-q", "-v", "-A", "-C"):
            pass
        elif a.startswith("-p") and a[2:].isdigit():
            port = int(a[2:])
        elif host is None:
            host = a
        else:
            command.append(a)
        i += 1

    if not host:
        raise SystemExit("git-ssh-paramiko: no host given")
    if not command:
        raise SystemExit("git-ssh-paramiko: no command given")

    if username is None and "@" in host:
        username, host = host.split("@", 1)
    username = username or os.environ.get("GIT_SSH_USER", "git")
    port = port or 22
    return host, port, username, command


def pump_stdout(channel, done):
    """channel -> our stdout, using recv() which returns available data."""
    try:
        while True:
            data = channel.recv(32768)
            if not data:
                break
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
    except Exception:
        pass
    finally:
        try:
            sys.stdout.buffer.flush()
        except Exception:
            pass
        done.set()


def pump_stderr(channel, done):
    """channel stderr -> our stderr."""
    try:
        while True:
            data = channel.recv_stderr(32768)
            if not data:
                break
            sys.stderr.buffer.write(data)
            sys.stderr.buffer.flush()
    except Exception:
        pass
    finally:
        try:
            sys.stderr.buffer.flush()
        except Exception:
            pass
        done.set()


def pump_stdin(channel, done):
    """our stdin -> channel, using raw os.read() (returns any available data)."""
    try:
        fd = sys.stdin.fileno()
        while True:
            data = os.read(fd, 65536)
            if not data:
                break
            channel.sendall(data)
    except Exception:
        pass
    finally:
        try:
            channel.shutdown_write()  # signal EOF to the remote command
        except Exception:
            pass
        done.set()


def main() -> int:
    host, port, username, command = parse_args(sys.argv[1:])
    key_file = Path.home() / ".ssh" / "id_ed25519"

    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    try:
        pkey = paramiko.Ed25519Key.from_private_key_file(str(key_file))
        client.connect(
            hostname=host,
            port=port,
            username=username,
            pkey=pkey,
            look_for_keys=False,
            allow_agent=False,
            timeout=30,
            banner_timeout=30,
        )
    except paramiko.ssh_exception.AuthenticationException:
        sys.stderr.write(
            "git-ssh-paramiko: authentication failed — add your public key "
            f"({key_file}.pub) at https://github.com/settings/ssh/new\n"
        )
        return 255
    except Exception as e:  # noqa: BLE001
        sys.stderr.write(f"git-ssh-paramiko: connection failed: {e}\n")
        return 255

    try:
        transport = client.get_transport()
        transport.set_keepalive(30)
        channel = transport.open_session()
        channel.exec_command(" ".join(command))

        done_out = threading.Event()
        done_err = threading.Event()
        done_in = threading.Event()

        threads = [
            threading.Thread(target=pump_stdout, args=(channel, done_out), daemon=True),
            threading.Thread(target=pump_stderr, args=(channel, done_err), daemon=True),
            threading.Thread(target=pump_stdin, args=(channel, done_in), daemon=True),
        ]
        for t in threads:
            t.start()

        # Wait for the remote command to exit (bounded)
        deadline = time.monotonic() + REMOTE_TIMEOUT
        while not channel.exit_status_ready():
            if time.monotonic() > deadline:
                sys.stderr.write("git-ssh-paramiko: remote command timed out\n")
                channel.close()
                return 255
            time.sleep(0.05)

        status = channel.recv_exit_status()

        # Drain any remaining output before closing (short grace period)
        done_out.wait(10)
        done_err.wait(10)
        channel.close()
        return status
    finally:
        client.close()


if __name__ == "__main__":
    sys.exit(main())
